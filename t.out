&#x27;re looking for."/><meta property="og:url" content="https://www.jazzhr.com/job-seekers"/><meta property="og:site_name" content="JazzHR"/><meta property="og:locale" content="en_US"/><meta property="og:image" content="https://www.jazzhr.com/images/og-default.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="For Job Seekers"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:site" content="@JazzHR"/><meta name="twitter:creator" content="@JazzHR"/><meta name="twitter:title" content="For Job Seekers"/><meta name="twitter:description" content="Trying to apply for a job? JazzHR is an applicant tracking system (ATS) used by businesses to organize hiring — not a job board. Here&#x27;s how to find the roles you&#x27;re looking for."/><meta name="twitter:image" content="https://www.jazzhr.com/images/og-default.png"/><link rel="icon" href="/icon.png?83145027278ab79a" type="image/png" sizes="152x152"/><script>(self.__next_s=self.__next_s||[]).push([0,{"children":"window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('consent', 'default', {\n  ad_storage: 'denied',\n  ad_user_data: 'denied',\n  ad_personalization: 'denied',\n  analytics_storage: 'denied',\n  functionality_storage: 'denied',\n  personalization_storage: 'denied',\n  security_storage: 'granted',\n  wait_for_update: 500\n});","id":"gcm-default"}])</script><script>(self.__next_s=self.__next_s||[]).push(["https://cdn-cookieyes.com/client_data/2354fecad56160e05ead6ffb/script.js",{"id":"cookieyes"}])</script><script src="/_next/static/chunks/polyfills-42372ed130431b0a.js?dpl=dpl_A7ZrRptqCzFLPxpLH6Yf8pfxzARz" noModule=""></script></head><body><div hidden=""><!--$--><!--/$--></div><script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"JazzHR","url":"https://www.jazzhr.com","description":"JazzHR is powerful, user-friendly recruiting software that helps small businesses find and hire talent fast. Streamline your hiring process today.","logo":{"@type":"ImageObject","url":"https://www.jazzhr.com/images/jazzhr-only-logo.svg"},"sameAs":["https://twitter.com/JazzHR","https://linkedin.com/company/jazzhr"]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"JazzHR","url":"https://www.jazzhr.com","description":"Powerful, user-friendly recruiting software that helps small businesses find and hire talent fast."}</script><div style="padding-top:var(--promo-banner-h, 0px);transition:padding-top .35s ease"><div><header class="fixed top-[var(--promo-banner-h,0px)] right-0 left-0 z-50"><div class="transition-all duration-200 bg-white/90 backdrop-blur-lg"><nav role="navigation" aria-label="Main navigation" class="mx-auto grid h-16 max-w-7xl grid-cols-3 items-center px-4 sm:px-6 lg:px-8"><div class="flex items-center gap-3 justify-self-start sm:gap-4"><a class="flex shrink-0 items-center" href="/"><img alt="JazzHR" width="100" height="32" decoding="async" data-nimg="1" class="h-5 w-auto transition-all duration-200 sm:h-6 lg:h-7 " style="color:transparent" src="/images/jazzhr-only-logo.svg"/></a><a target="_blank" rel="noopener noreferrer" class="group hidden items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-xs font-medium transition-all duration-200 lg:inline-flex border-primary-200 text-primary-700 hover:border-primary-300 hover:bg-primary-50" href="https://app.jazz.co/app/v2/login">Sign In<svg class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-px group-hover:-translate-y-px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10"></path></svg></a></div><div class="relative hidden items-center justify-center gap-1 justify-self-center lg:flex" role="menubar"><div class="pointer-events-none absolute rounded-lg transition-all duration-200 ease-out bg-primary-50" style="left:0;width:0;height:36px;top:50%;transform:translateY(-50%);opacity:0"></div><div class="relative"><button role="menuitem" aria-expanded="false" aria-haspopup="menu" aria-controls="products-menu" class="focus-visible:ring-primary-500 relative flex items-center gap-1 rounded-lg px-4 py-2 text-sm font-medium transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 text-gray-700 hover:text-gray-900">Products<svg class="h-4 w-4 transition-transform duration-200 " fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg></button></div><div class="relative"><button role="menuitem" aria-expanded="false" aria-haspopup="menu" aria-controls="compare-menu" class="focus-visible:ring-primary-500 relative flex items-center gap-1 rounded-lg px-4 py-2 text-sm font-medium transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 text-gray-700 hover:text-gray-900">Compare<svg class="h-4 w-4 transition-transform duration-200 " fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg></button></div><div class="relative"><button role="menuitem" aria-expanded="false" aria-haspopup="menu" aria-controls="resources-menu" class="focus-visible:ring-primary-500 relative flex items-center gap-1 rounded-lg px-4 py-2 text-sm font-medium transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 text-gray-700 hover:text-gray-900">Resources<svg class="h-4 w-4 transition-transform duration-200 " fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg></button></div><div class="relative"><button role="menuitem" aria-expanded="false" aria-haspopup="menu" aria-controls="company-menu" class="focus-visible:ring-primary-500 relative flex items-center gap-1 rounded-lg px-4 py-2 text-sm font-medium transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 text-gray-700 hover:text-gray-900">Company<svg class="h-4 w-4 transition-transform duration-200 " fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg></button></div></div><div class="hidden items-center gap-3 justify-self-end lg:flex"><a class="rounded-full px-5 py-2.5 text-sm font-medium shadow-lg transition-all duration-200 hover:shadow-xl bg-primary-700 shadow-primary-700/25 hover:bg-primary-800 hover:shadow-primary-700/30 text-white" href="/request-a-demo">Request Demo</a><a class="rounded-full border px-5 py-2.5 text-sm font-medium transition-all duration-200 border-primary-200 text-primary-700 hover:border-primary-300 hover:bg-primary-50" href="/pricing">Pricing</a></div><div class="col-start-3 justify-self-end lg:hidden"><button class="bg-primary-700 shadow-primary-700/25 hover:bg-primary-800 flex h-10 w-10 items-center justify-center rounded-xl text-white shadow-lg transition-colors lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><div class="relative h-4 w-4"><span class="absolute left-0 block h-[2px] w-full rounded-full bg-current transition-all duration-300 ease-out top-[10%] translate-y-0 rotate-0"></span><span class="absolute top-[55%] left-0 block h-[2px] w-full -translate-y-1/2 rounded-full bg-current transition-all duration-300 ease-out scale-x-100 opacity-100"></span><span class="absolute left-0 block h-[2px] w-full rounded-full bg-current transition-all duration-300 ease-out top-[90%] translate-y-0 rotate-0"></span></div></button></div></nav></div></header><main class="bg-white"><section class="from-primary-50 to-accent-50 relative overflow-hidden bg-gradient-to-br via-white pt-28 pb-16 lg:pt-36 lg:pb-24"><div class="bg-accent-200/40 pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full blur-3xl"></div><div class="bg-primary-200/30 pointer-events-none absolute top-1/2 -left-40 h-96 w-96 rounded-full blur-3xl"></div><div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16"><div><h1 class="text-primary-900 text-[2.5rem] leading-[1.08] font-bold tracking-tight sm:text-5xl lg:text-[3.25rem]">Trying to apply for a job?</h1><p class="mt-4 text-2xl font-semibold sm:text-3xl"><span class="text-primary-700">Please </span><span class="from-primary-600 to-accent-600 bg-gradient-to-r bg-clip-text text-transparent">read</span><span class="text-primary-700"> before you </span><span class="from-primary-600 to-accent-600 bg-gradient-to-r bg-clip-text text-transparent">proceed</span></p></div><div class="scroll-reveal reveal-delay-1 relative"><div class="from-primary-200/50 to-accent-200/50 absolute -inset-3 -rotate-2 rounded-[1.75rem] bg-gradient-to-br"></div><img alt="Job seeker searching for open roles" width="508" height="339" decoding="async" data-nimg="1" class="relative w-full rounded-2xl object-cover shadow-xl" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fjob-seekers%2Fjob-seeker-photo.jpg&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fimages%2Fjob-seekers%2Fjob-seeker-photo.jpg&amp;w=1080&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fjob-seekers%2Fjob-seeker-photo.jpg&amp;w=1080&amp;q=75"/></div></div></div></section><section class="py-16 lg:py-20"><div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8"><div class="scroll-reveal space-y-5"><p class="text-primary-800 text-lg leading-relaxed">JazzHR is an<!-- --> <a class="text-primary-700 hover:text-primary-900 font-semibold underline underline-offset-2" href="/solutions/applicant-tracking-software">applicant tracking system (ATS)</a> <!-- -->– software that businesses use to organize their hiring process and host their career pages.</p><p class="text-primary-900 text-lg leading-relaxed font-semibold">JazzHR is not a job board and, unfortunately, cannot help you get a job.</p><p class="text-lg leading-relaxed text-neutral-600">Please navigate back to the website where you originally tried to apply for a job and try again.</p></div><ul class="scroll-reveal reveal-delay-1 mt-10 space-y-5"><li class="flex gap-3.5"><span class="bg-primary-100 text-primary-700 mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"></path></svg></span><p class="text-primary-800 leading-relaxed">If you end up back here,<!-- --> <strong>please reach out to the organization you’re interested in working for directly.</strong></p></li><li class="flex gap-3.5"><span class="bg-primary-100 text-primary-700 mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"></path></svg></span><p class="text-primary-800 leading-relaxed">If you are looking for a job currently, most of our customers post their open roles on all major job boards like Indeed, LinkedIn, ZipRecruiter, and more. Please go directly to those sites to search for additional open roles.<!-- --> <strong>(And best of luck!)</strong></p></li><li class="flex gap-3.5"><span class="bg-primary-100 text-primary-700 mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"></path></svg></span><p class="text-primary-800 leading-relaxed">If you are a business looking to evaluate recruiting software for your hiring needs,<!-- --> <a class="text-primary-700 hover:text-primary-900 font-semibold underline underline-offset-2" href="/request-a-demo">please navigate to our main website</a> <!-- -->to schedule time with one of our solutions consultants.</p></li></ul></div></section><section class="bg-primary-50/40 py-16 lg:py-24"><div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8"><div class="grid gap-6 sm:grid-cols-2"><div class="scroll-reveal flex flex-col rounded-2xl border border-neutral-200/80 bg-white p-7 shadow-sm"><h3 class="text-primary-900 text-lg font-semibold tracking-tight">What is an applicant tracking system (ATS)?</h3><p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-600">Many companies that do any kind of hiring tend to use software like JazzHR to automate the recruiting process.<!-- --> <a class="text-primary-700 hover:text-primary-900 font-semibold underline underline-offset-2" href="/solutions/applicant-tracking-software">Read up on what an applicant tracking system is.</a></p></div><div class="scroll-reveal flex flex-col rounded-2xl border border-neutral-200/80 bg-white p-7 shadow-sm"><h3 class="text-primary-900 text-lg font-semibold tracking-tight">Make sure your resume is ATS-friendly</h3><p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-600">Now that you know what an ATS is, check out<!-- --> <a class="text-primary-700 hover:text-primary-900 font-semibold underline underline-offset-2" href="/blog/ats-resume-formatting">our blog for formatting tips</a> <!-- -->and tricks to help make your application stand out.</p></div><div class="scroll-reveal flex flex-col rounded-2xl border border-neutral-200/80 bg-white p-7 shadow-sm"><h3 class="text-primary-900 text-lg font-semibold tracking-tight">20 Interview Tips to Make a Great Impression</h3><p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-600">Ready to nail that interview? Make sure you read up on<!-- --> <a href="https://www.indeed.com/career-advice/interviewing/job-interview-tips-how-to-make-a-great-impression" target="_blank" rel="noopener noreferrer" class="text-primary-700 hover:text-primary-900 font-semibold underline underline-offset-2">Indeed’s latest article</a> <!-- -->which outlines 20 ways to make a great impression during your interviews.</p></div><div class="scroll-reveal flex flex-col rounded-2xl border border-neutral-200/80 bg-white p-7 shadow-sm"><h3 class="text-primary-900 text-lg font-semibold tracking-tight">Looking for additional job seeker resources?</h3><p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-600">Check out Indeed’s Career Guide center.</p><a href="https://www.indeed.com/career-advice" target="_blank" rel="noopener noreferrer" class="bg-primary-700 hover:bg-primary-800 group mt-6 inline-flex w-fit items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-colors">Go to Indeed<svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"></path></svg></a></div></div></div></section></main></div><!--$--><!--/$--><footer class="border-primary-100 relative overflow-hidden border-t bg-white"><div class="pointer-events-none absolute inset-0 overflow-hidden"><div class="parallax-slow absolute top-20 -left-10 h-10 w-36 -rotate-12 rounded-full opacity-50" style="background:linear-gradient(145deg, #f5eaf8, #ebd5f1);box-shadow:inset 3px 3px 6px rgba(168, 92, 194, 0.2), inset -3px -3px 6px rgba(255, 255, 255, 0.9)"></div><div class="parallax-medium absolute top-40 left-16 h-8 w-24 rotate-6 rounded-full opacity-45" style="background:linear-gradient(145deg, #f0fdfa, #ccfbf1);box-shadow:inset 3px 3px 6px rgba(20, 184, 166, 0.15), inset -3px -3px 6px rgba(255, 255, 255, 0.9)"></div><div class="parallax-fast absolute bottom-32 left-8 h-6 w-20 -r